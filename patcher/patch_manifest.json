    {
      "label": "OAuth redirect to root",
      "target": "open_webui/utils/oauth.py",
      "needle": "redirect_url = redirect_base_url or '/'"
    },
    {
      "label": "PDF OCR loader",
      "target": "open_webui/retrieval/loaders/main.py",
      "needle": "class SmartPDFLoader"
    },
    {
      "label": "Image OCR loader",
      "target": "open_webui/retrieval/loaders/main.py",
      "needle": "class RapidOCRImageLoader"
    },
    {
      "label": "Settings loader shim",
      "target": "open_webui/static/loader.js",
      "needle": "owui-sso-height"
    }
  ]
}
