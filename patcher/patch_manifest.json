    {
      "source": "payload/open_webui/main.py",
      "target": "open_webui/main.py"
    },
    {
      "source": "payload/open_webui/routers/auths.py",
      "target": "open_webui/routers/auths.py"
    },
    {
      "source": "payload/open_webui/routers/files.py",
      "target": "open_webui/routers/files.py"
    },
    {
      "source": "payload/open_webui/retrieval/loaders/main.py",
      "target": "open_webui/retrieval/loaders/main.py"
    },
    {
      "source": "payload/open_webui/utils/oauth.py",
      "target": "open_webui/utils/oauth.py"
    },
    {
      "source": "payload/open_webui/static/loader.js",
      "target": "open_webui/static/loader.js"
    },
    {
      "source": "payload/open_webui/frontend/static/loader.js",
      "target": "open_webui/frontend/static/loader.js"
    }
  ],
  "contains_checks": [
    {
      "label": "SSO UI endpoint",
      "target": "open_webui/routers/auths.py",
